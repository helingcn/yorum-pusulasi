# Bu dosyayı .env.local olarak kopyalayıp kendi ortamına göre doldur.
# .env.local git'e eklenmez (bkz. .gitignore).

# api.py'nin çalıştığı adres. Varsayılan: http://localhost:8000
# (README'deki `uvicorn api:app --port 8000` komutuyla eşleşir).
VITE_API_BASE_URL=http://localhost:8000

# api.py'de API_ANAHTARI ortam değişkeni ayarlandıysa buraya AYNI değer
# girilmeli. NOT: bu anahtar tarayıcıya gönderilen kodun içine gömülür,
# gerçek bir sır değildir — yalnızca yerel/iç kullanım için uygundur.
# VITE_API_ANAHTARI=
