# Copy this file to .env.local and fill it in for your own environment.
# .env.local is not committed to git (see .gitignore).

# The address api.py is running on. Default: http://localhost:8000
# (matches the `uvicorn api:app --port 8000` command in the README).
VITE_API_BASE_URL=http://localhost:8000

# If the API_ANAHTARI environment variable is set in api.py, the SAME value
# must be entered here. NOTE: this key gets bundled into the code sent to
# the browser — it is NOT a real secret, only suitable for local/internal use.
# VITE_API_ANAHTARI=
